<script type="application/json" data-pc-cart-previews>
  {
    "items": [
      {%- for item in cart.items -%}
        {
          "key": {{ item.key | json }},
          "id": {{ item.variant_id | json }},
          "properties": {{ item.properties | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Customizer cart images",
  "target": "section",
  "javascript": "cart-previews.js",
  "stylesheet": "customizer.css",
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}
